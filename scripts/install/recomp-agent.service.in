[Unit]
Description=Recomp Profiler agent
# Needs DISPLAY/WAYLAND_DISPLAY from the desktop session to launch games.
PartOf=graphical-session.target
After=graphical-session.target

[Service]
# bind/port/allowlist come from config.toml (recomp-profiler tui)
ExecStart=@AGENT@ serve
Restart=on-failure
RestartSec=3

[Install]
WantedBy=graphical-session.target
